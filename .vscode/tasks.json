{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build & Run (Windows exe via Wine)",
            "type": "shell",
            "command": "x86_64-w64-mingw32-gcc",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                "${file}",
                "-o",
                "${fileDirname}/${fileBasenameNoExtension}.exe",
                "&&",
                "wine",
                "${fileDirname}/${fileBasenameNoExtension}.exe"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": ["$gcc"],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Compile and run Windows exe using Wine"
        }
    ]
}
